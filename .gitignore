# ── environments ──
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# ── macOS ──
.DS_Store

# ── model weights & data: these belong on the HF Hub, never in git ──
# git keeps every version of every binary forever; a 9 MB adapter committed
# ten times is 90 MB you cannot reclaim without rewriting history.
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf
checkpoints/
checkpoint-*/
outputs/*
runs/
data/
gpt2-medqa-lora/
tinyllama-medqa-qlora/

# Generated artifacts stay out — except the blinded review, which is hand-rated
# work that cannot be regenerated by rerunning anything.
# key.json unblinds sheet.md: a second rater must not read it before rating.
!outputs/review/
outputs/review/*
!outputs/review/sheet.md
!outputs/review/ratings.json
!outputs/review/ratings.claude.json
!outputs/review/key.json

# ── secrets ──
.env
.env.*
*.token
*credentials*.json

# ── logs ──
*.log
wandb/
